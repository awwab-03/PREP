# ───────────────────────────────────────────────
# PrepAI Backend — Environment Variables
# Copy this file to `.env` and fill in real values.
# ───────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/prepai?retryWrites=true&w=majority

# JWT (HS256). Use a long random string in production.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Frontend origin (for CORS). In production set to your Vercel URL.
CLIENT_URL=http://localhost:5173
